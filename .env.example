# Telegram Bot Token (from @BotFather)
TELEGRAM_TOKEN=your_telegram_bot_token_here

# Authorization (comma-separated Telegram user IDs)
AUTHORIZED_USER_ID=123456789,987654321

# Bot conversation-state persistence (PicklePersistence). Defaults to
# ./data/bot_data.pickle (relative to the working directory). Docker overrides
# this to /app/data/bot_data.pickle.
# BOT_DATA_FILE=./data/bot_data.pickle

# ---------------------------------------------------------------------------
# AI Bengkel configuration (migration to local database + DeepSeek/Gemini)
# ---------------------------------------------------------------------------

# Local database (SQLite). Switch to PostgreSQL later by changing this URL.
DATABASE_URL=sqlite:///./data/workshop.db

# AI provider selection: deepseek | openrouter (default: deepseek).
AI_PROVIDER=deepseek

# DeepSeek AI (chat + function calling). Used when AI_PROVIDER=deepseek.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# OpenRouter AI (chat + vision). Used when AI_PROVIDER=openrouter; photo/vision
# always uses OpenRouter. Chat model and vision model are independent — set the
# model IDs you actually use (e.g. openai/gpt-4o-mini, anthropic/claude-3.5-sonnet).
OPENROUTER_API_KEY=
OPENROUTER_CHAT_MODEL=
OPENROUTER_VISION_MODEL=

# Local API server (for the future localhost UI). Bind to loopback by default.
APP_HOST=127.0.0.1
APP_PORT=8000

# API access token for the local UI (bearer token). Protected endpoints reject
# all requests until this is set. Do not commit a real token.
UI_ACCESS_TOKEN=

# Backup directory for the local UI (SQLite backups). Keep outside web-static paths.
BACKUP_DIR=data/backups

# ---------------------------------------------------------------------------
# WhatsApp CS + Baileys gateway (optional; defaults shown are the code defaults)
# ---------------------------------------------------------------------------

# WhatsApp CS database (SQLite). Defaults to <project root>/data/whatsapp_cs.db.
# WHATSAPP_DB_URL=

# Baileys gateway bridge (gateway/whatsapp_bridge.js). Defaults shown.
# BAILEYS_HOST=127.0.0.1
# BAILEYS_PORT=9090
# BAILEYS_AUTH_DIR=data/baileys_session
# BAILEYS_INBOUND_URL=http://127.0.0.1:8000/api/integrations/whatsapp/inbound
# BAILEYS_LOG_LEVEL=silent